<Window x:Class="Keynote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Keynote.App"
        Title="larpiano"
        Icon="Assets/larpiano.ico"
        Width="1536" Height="1024"
        MinWidth="1000" MinHeight="700"
        Background="Transparent"
        FontFamily="{StaticResource ModernSansFontFamily}"
        FontSize="13"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop"
        Closing="OnClosing"
        SourceInitialized="OnSourceInitialized"
        StateChanged="OnWindowStateChanged"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                      ResizeBorderThickness="8"
                      CornerRadius="14"
                      GlassFrameThickness="1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Outer Rounded Frame with 14px Corner Radius -->
    <Border x:Name="WindowFrame"
            Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TOP HEADER (Rounded Top Corners) -->
            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Background="{StaticResource HeaderBackgroundBrush}" CornerRadius="14,14,0,0">
                <Grid Margin="24,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Original Larpiano Logo & Wordmark -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/logo.png" Width="30" Height="30" Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="larpiano logo" />
                        <TextBlock Text="larpiano" Style="{StaticResource HeaderBrandTextStyle}" />
                        <TextBlock Text="  /  piano player" Style="{StaticResource HeaderDescriptorTextStyle}" Margin="6,0,0,0" />
                    </StackPanel>

                    <!-- Right: Status & Window Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Status Indicator -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource StatusReadyBrush}" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#35D39A" Opacity="0.8" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="ShellStatus" Text="ready" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Custom Window Caption Buttons -->
                        <Button Content="−" Click="MinimizeWindow" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="Minimize" />
                        <Button Content="□" Click="MaximizeWindow" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="Maximize" />
                        <Button Content="✕" Click="CloseWindow" Style="{StaticResource WindowCloseCaptionButtonStyle}" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN BODY (Sidebar + Content + Bottom Player Bar) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="244" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- MainTabs TabControl spans both columns so its template hosts the sidebar in Col 0 and content in Col 1 -->
                <TabControl x:Name="MainTabs" Grid.ColumnSpan="2" TabStripPlacement="Left" SelectionChanged="MainTabChanged">

                    <!-- TAB 0: PLAYER -->
                    <TabItem Header="Player" Tag="▷">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="38,20,38,104">
                                <StackPanel HorizontalAlignment="Stretch">

                                    <!-- HERO SECTION -->
                                    <Grid Margin="0,0,0,18" Height="170">
                                        <!-- Background Grand Piano Keys with Smooth Radial Fog Mask -->
                                        <Image Source="Assets/hero_piano_keys.jpg" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Height="170" Width="680" Stretch="UniformToFill" Margin="0,0,-24,0" ClipToBounds="True">
                                            <Image.OpacityMask>
                                                <RadialGradientBrush Center="0.8,0.5" GradientOrigin="0.8,0.5" RadiusX="0.7" RadiusY="0.7">
                                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                    <GradientStop Color="#E0FFFFFF" Offset="0.35" />
                                                    <GradientStop Color="#00FFFFFF" Offset="0.9" />
                                                </RadialGradientBrush>
                                            </Image.OpacityMask>
                                        </Image>

                                        <!-- Hero Typography with Original Preserved Taglines -->
                                        <StackPanel VerticalAlignment="Center" MaxWidth="620" HorizontalAlignment="Left">
                                            <TextBlock Text="PIANO PLAYER" Style="{StaticResource HeroEyebrowTextStyle}" />
                                            <TextBlock Style="{StaticResource HeroHeadingTextStyle}">
                                                <Run Text="Ready " Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="when you are." Foreground="{StaticResource AccentLavenderBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="Choose your Roblox window, pick a song and start playing." Style="{StaticResource HeroSubtitleTextStyle}" Margin="0,0,0,8" />
                                            <!-- Verbatim Original Larpiano Taglines -->
                                            <TextBlock Text="from da people who LARP, for da people who LARP" Foreground="#C3BCCB" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3" TextWrapping="Wrap" />
                                            <TextBlock Text="for da people who larp  ·  for da poeple who believe in larpocracy" Foreground="#AAA3B6" FontSize="11" Margin="0,0,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- SELECTOR ROW -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Roblox Window Selector Card (auto-refreshes on dropdown open) -->
                                        <ComboBox x:Name="Windows" Style="{StaticResource RobloxSelectorComboBoxStyle}"
                                                  SelectionChanged="WindowSelected" DropDownOpened="RefreshWindows"
                                                  ToolTip="Select your Roblox game window" />

                                        <!-- Song Selector Card -->
                                        <ComboBox x:Name="PlayerSongSelector" Grid.Column="2" Style="{StaticResource SongSelectorComboBoxStyle}"
                                                  SelectionChanged="PlayerSongSelected" DisplayMemberPath="Title"
                                                  ToolTip="Choose a song from your library" />

                                        <!-- Browse MIDI Button -->
                                        <Button Grid.Column="4" Style="{StaticResource LarpianoOutlinedButton}" Click="Browse" Height="56" Padding="22,0"
                                                ToolTip="Import a local MIDI file">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📁" FontSize="15" Margin="0,0,10,0" Foreground="{StaticResource AccentLavenderBrush}" />
                                                <TextBlock Text="Browse MIDI" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentLavenderBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Hidden ConnectionStatus for code-behind bindings -->
                                    <TextBlock x:Name="ConnectionStatus" Visibility="Collapsed" />

                                    <!-- WORKSPACE AREA -->
                                    <Border Background="#14131D" BorderBrush="#2A243A" BorderThickness="1" CornerRadius="14" Height="250" Margin="0,0,0,16" ClipToBounds="True">
                                        <Grid>
                                            <!-- Ambient Soundwave Background -->
                                            <Image Source="Assets/waveform_art.jpg" Stretch="UniformToFill" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

                                            <!-- Empty State -->
                                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                                <Border Width="46" Height="46" CornerRadius="12" Background="#241E34" BorderBrush="#362E4D" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                    <TextBlock Text="♫" Foreground="{StaticResource AccentLavenderBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="No song selected" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                <TextBlock Text="Select a song from Discover, My Library or import a MIDI file." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="🔍  Discover Songs" Click="GoDiscover" Style="{StaticResource LarpianoPrimaryPillButton}" Margin="0,0,12,0" />
                                                    <Button Click="GoLibrary" Style="{StaticResource LarpianoOutlinedButton}" Margin="0,0,12,0" Padding="18,10">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📁" FontSize="14" Margin="0,0,8,0" Foreground="{StaticResource AccentLavenderBrush}" />
                                                            <TextBlock Text="My Library" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="Browse" Style="{StaticResource LarpianoOutlinedButton}" Padding="18,10">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⭳" FontSize="14" Margin="0,0,8,0" Foreground="{StaticResource AccentLavenderBrush}" />
                                                            <TextBlock Text="Import MIDI" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Loaded Workspace -->
                                            <Grid x:Name="LoadedWorkspace" Visibility="Collapsed" Margin="20">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock x:Name="SongTitle" Text="—" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="SongInfo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="SongSource" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="Source, license and checksum" />
                                                    <TextBlock x:Name="PlayerMapping" Foreground="{StaticResource AccentLavenderBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Row="1" Background="#0C0C12" BorderBrush="#252033" BorderThickness="1" CornerRadius="8" ClipToBounds="True" MinHeight="130">
                                                    <local:PianoRoll x:Name="Roll" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Status Label (Subtle) -->
                                    <TextBlock x:Name="Status" Text="Choose a song and a Roblox window." Foreground="{StaticResource AccentPurpleBrush}" FontSize="12" Margin="4,0,0,14" TextWrapping="Wrap" />

                                    <!-- 4 QUICK ACTION CARDS -->
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Card 1: Play / Pause -->
                                        <Button Style="{StaticResource QuickActionButtonStyle}" Click="PlayPause" Height="68">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="8" Background="#241B38" VerticalAlignment="Center">
                                                    <TextBlock Text="▶" FontSize="14" Foreground="{StaticResource AccentLavenderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="Play / Pause" Style="{StaticResource QuickActionTitleTextStyle}" />
                                                    <TextBlock x:Name="ShortcutHint" Text="Ctrl + Alt + F8" Style="{StaticResource QuickActionSubtextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Card 2: Stop -->
                                        <Button Grid.Column="2" Style="{StaticResource QuickActionButtonStyle}" Click="Stop" Height="68">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="8" Background="#241B38" VerticalAlignment="Center">
                                                    <TextBlock Text="■" FontSize="14" Foreground="{StaticResource AccentLavenderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="Stop" Style="{StaticResource QuickActionTitleTextStyle}" />
                                                    <TextBlock x:Name="StopHint" Text="Ctrl + Alt + F9" Style="{StaticResource QuickActionSubtextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Card 3: Mapping (Vector Target) -->
                                        <Button Grid.Column="4" Style="{StaticResource QuickActionButtonStyle}" Click="GoMapping" Height="68">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="8" Background="#241B38" VerticalAlignment="Center">
                                                    <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse Stroke="{StaticResource AccentLavenderBrush}" StrokeThickness="1.5" />
                                                        <Ellipse Width="4" Height="4" Fill="{StaticResource AccentLavenderBrush}" />
                                                        <Line X1="8" Y1="0" X2="8" Y2="3" Stroke="{StaticResource AccentLavenderBrush}" StrokeThickness="1.5" />
                                                        <Line X1="8" Y1="13" X2="8" Y2="16" Stroke="{StaticResource AccentLavenderBrush}" StrokeThickness="1.5" />
                                                        <Line X1="0" Y1="8" X2="3" Y2="8" Stroke="{StaticResource AccentLavenderBrush}" StrokeThickness="1.5" />
                                                        <Line X1="13" Y1="8" X2="16" Y2="8" Stroke="{StaticResource AccentLavenderBrush}" StrokeThickness="1.5" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="Mapping" Style="{StaticResource QuickActionTitleTextStyle}" />
                                                    <TextBlock Text="Calibrate keys" Style="{StaticResource QuickActionSubtextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Card 4: Diagnostics (Vector Equalizer Bars) -->
                                        <Button Grid.Column="6" Style="{StaticResource QuickActionButtonStyle}" Click="GoSettings" Height="68">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" CornerRadius="8" Background="#241B38" VerticalAlignment="Center">
                                                    <Path Data="M 3,13 L 3,5 M 7,16 L 7,2 M 11,14 L 11,6 M 15,11 L 15,7"
                                                          Stroke="{StaticResource AccentLavenderBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="16" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="Diagnostics" Style="{StaticResource QuickActionTitleTextStyle}" />
                                                    <TextBlock Text="Input, focus, performance" Style="{StaticResource QuickActionSubtextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Grid>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- TAB 1: DISCOVER -->
                    <TabItem Header="Discover" Tag="🌐">
                        <Grid Margin="32,24,32,100">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Discover MIDI" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Search by title or artist. MIDIsss is user uploaded; Mutopia results come from its public catalogue." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,16" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SearchQuery" ToolTip="Song title or artist" TextChanged="OnlineSearchChanged" PreviewKeyDown="SearchKeyDown" GotKeyboardFocus="SearchFocus" LostKeyboardFocus="SearchBlur" MinHeight="38" />
                                    <Button Grid.Column="1" Content="Search / Retry" Click="OnlineSearch" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" />
                                    <Button Grid.Column="2" Content="Cancel" Click="CancelOnline" Margin="8,0,0,0" />
                                </Grid>
                                <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                                    <ComboBox x:Name="DiscoverFilter" SelectionChanged="FilterChanged" SelectedIndex="0" Width="190" Margin="0,0,8,0">
                                        <ComboBoxItem Content="All results" />
                                        <ComboBoxItem Content="Piano-instrument candidate" />
                                        <ComboBoxItem Content="Multi-track (inspected)" />
                                        <ComboBoxItem Content="Not yet inspected" />
                                    </ComboBox>
                                    <ComboBox x:Name="CatalogSelector" SelectedIndex="0" SelectionChanged="OnlineProviderChanged" Width="170">
                                        <ComboBoxItem Content="All providers" />
                                        <ComboBoxItem Content="MIDIsss" />
                                        <ComboBoxItem Content="Mutopia catalogue" />
                                    </ComboBox>
                                </WrapPanel>
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="SearchResults" Background="{StaticResource PanelElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" SelectionChanged="OnlineResultSelected" />
                                <ListBox x:Name="SearchSuggestions" Grid.Column="0" Visibility="Collapsed" MaxHeight="170" VerticalAlignment="Top" Background="#242033" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource AccentPurpleBrush}" Panel.ZIndex="10" LostKeyboardFocus="SearchBlur" MouseDoubleClick="SuggestionChosen" />
                                <Border Grid.Column="2" Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="Arrangement details" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock x:Name="ResultDetails" Text="Select a result to review it." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />
                                            <WrapPanel Margin="0,14,0,0">
                                                <Button Content="Download and inspect" Click="DownloadResult" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" />
                                                <Button Content="Open source page" Click="OpenSelectedSource" />
                                            </WrapPanel>
                                            <TextBlock x:Name="InspectionText" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
                                            <TextBlock x:Name="PreflightText" Foreground="{StaticResource AccentLavenderBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                            <ItemsControl x:Name="TrackChoices" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="Import selected tracks &amp; play" Click="ImportOnline" HorizontalAlignment="Left" Margin="0,12,0,0" Style="{StaticResource PrimaryButton}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                <TextBlock x:Name="DiscoverStatus" Text="Search to find MIDI arrangements." Foreground="{StaticResource AccentLavenderBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ProviderStatus" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <Button x:Name="NextPage" Content="Next page" Click="SearchNextPage" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Mutopia website" Tag="mutopia" Click="OpenProvider" Margin="0,0,8,0" />
                                    <Button Content="BitMidi website" Tag="bitmidi" Click="OpenProvider" Margin="0,0,8,0" />
                                    <Button Content="MIDI Collection website" Tag="collection" Click="OpenProvider" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: EXTRACT -->
                    <TabItem Header="Extract" Tag="✨">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,100">
                            <StackPanel HorizontalAlignment="Stretch" MaxWidth="800">
                                <TextBlock Text="Extract piano MIDI" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Optional Opennan transcription. Song-name and video searches may choose a piano cover; the source and accuracy are not guaranteed." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,18" TextWrapping="Wrap" />
                                <TextBlock Text="Song name or HTTPS YouTube link" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                <TextBox x:Name="ExtractInput" Margin="0,6,0,12" MinHeight="38" />
                                <WrapPanel>
                                    <Button Content="Choose audio / video file" Click="ChooseAudio" Margin="0,0,8,0" />
                                    <Button Content="Clear file" Click="ClearAudio" Margin="0,0,8,0" />
                                    <TextBlock x:Name="AudioFileName" Text="No file selected" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                </WrapPanel>
                                <CheckBox x:Name="RightsCheck" Content="I have the rights to submit this content and accept Opennan's terms." Foreground="{StaticResource TextPrimaryBrush}" Margin="0,18,0,0" />
                                <TextBlock Text="Provider documentation advertises three free conversions per IP per day; the general terms also state that an account is required. Only solo piano recordings, up to 10 minutes and 200 MB, are supported for uploads." Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Content="Convert" Click="StartExtraction" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                    <Button Content="Cancel locally" Click="CancelOnline" Margin="0,0,8,0" />
                                    <Button Content="Opennan terms" Tag="terms" Click="OpenProvider" />
                                </WrapPanel>
                                <ProgressBar x:Name="ExtractProgress" Margin="0,18,0,0" />
                                <TextBlock x:Name="ExtractStatus" Text="No conversion started." Foreground="{StaticResource AccentLavenderBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="Cancelling stops larpiano's polling and download; the provider may continue the remote job." Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <Button Content="Inspect result" Click="InspectExtractResult" HorizontalAlignment="Left" Margin="0,14,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 3: MY LIBRARY -->
                    <TabItem Header="My Library" Tag="📚">
                        <Grid Margin="32,24,32,100">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="My Library" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Select a song, focus Roblox, then press Ctrl+Alt+F8." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,16" />
                            </StackPanel>
                            <TextBox x:Name="LibraryQuery" Grid.Row="1" ToolTip="Search your library" TextChanged="LibrarySearchChanged" MinHeight="38" />
                            <ListBox SelectionChanged="LibrarySelected" x:Name="LibraryList" Grid.Row="2" Background="{StaticResource PanelElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" Margin="0,12,0,12" />
                            <StackPanel Grid.Row="3">
                                <WrapPanel>
                                    <Button Content="Refresh" Click="RefreshLibrary" Margin="0,0,8,0" />
                                    <Button Content="Inspect selected" Click="InspectLibrary" Margin="0,0,8,0" />
                                    <Button Content="Remove local entry" Click="RemoveLibrary" />
                                </WrapPanel>
                                <TextBlock x:Name="LibraryStatus" Text="No library entries yet." Foreground="{StaticResource AccentLavenderBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- TAB 4: MAPPING -->
                    <TabItem Header="Mapping" Tag="🎹">
                        <Grid Margin="32,24,32,100">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Keyboard mapping" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="The shared Visual Pianos layout is always used for this game." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Row="1" Margin="0,20,0,12">
                                <Button Content="Save profile" Click="SaveProfile" Margin="0,0,8,8" />
                                <Button Content="Test sequence" Click="TestSequence" Margin="0,0,20,8" />
                                <TextBlock Text="Octave shift" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,8" />
                                <ComboBox x:Name="Octave" Width="74" SelectedIndex="2" SelectionChanged="MappingChanged" Margin="0,0,0,8">
                                    <ComboBoxItem Content="-2" />
                                    <ComboBoxItem Content="-1" />
                                    <ComboBoxItem Content="0" />
                                    <ComboBoxItem Content="1" />
                                    <ComboBoxItem Content="2" />
                                </ComboBox>
                            </WrapPanel>
                            <Border Grid.Row="2" Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="MappingSummary" Foreground="{StaticResource AccentLavenderBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CalibrationStatus" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" Text="The app uses the shared Visual Pianos layout." TextWrapping="Wrap" />
                                    <CheckBox x:Name="VerifiedCheck" Content="Shared Visual Pianos layout" IsEnabled="False" Foreground="{StaticResource TextPrimaryBrush}" Click="VerifyProfile" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="MappingGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      Background="{StaticResource PanelElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                      RowBackground="{StaticResource PanelElevatedBrush}" AlternatingRowBackground="#151322"
                                      BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}" HeadersVisibility="Column" SelectionUnit="Cell" CellEditEnding="MappingEdit">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MIDI pitch" Binding="{Binding Pitch}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="Keyboard key (Shift supported)" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="2*">
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <EventSetter Event="PreviewKeyDown" Handler="CaptureMappingKey" />
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Test" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Test" Click="TestKey" Tag="{Binding}" Padding="10,4" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 5: SETTINGS -->
                    <TabItem Header="Settings" Tag="⚙">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,16,32,96">
                            <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
                                <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Choose the window that receives playback." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,12" />

                                <Border Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Roblox window" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Select a window, then focus it to start playback. Playback pauses if focus is lost; focus Roblox and use the shortcut to resume." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,8" TextWrapping="Wrap" />
                                        <TextBlock Text="Select or refresh the Roblox window on the Player screen." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Global shortcuts" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Shortcuts work without bringing larpiano to the foreground. Choose modifiers and function keys." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,8" TextWrapping="Wrap" />
                                        <WrapPanel>
                                            <CheckBox x:Name="HotkeyCtrl" Content="Ctrl" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" />
                                            <CheckBox x:Name="HotkeyAlt" Content="Alt" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" />
                                            <CheckBox x:Name="HotkeyShift" Content="Shift" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0" />
                                            <TextBlock Text="Play / Pause" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <ComboBox x:Name="ToggleKey" Width="72" Margin="0,0,16,0" />
                                            <TextBlock Text="Stop" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <ComboBox x:Name="StopKey" Width="72" Margin="0,0,12,0" />
                                            <Button Content="Apply" Click="ApplyHotkeys" Style="{StaticResource PrimaryButton}" />
                                        </WrapPanel>
                                        <TextBlock x:Name="HotkeyStatus" Foreground="{StaticResource AccentLavenderBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Controlled playback test" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Uses your manually verified mapping and selected foreground Roblox window. Pause/resume and emergency tests require the corresponding hotkeys." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,8" TextWrapping="Wrap" />
                                        <WrapPanel>
                                            <ComboBox x:Name="TestPattern" Width="180" SelectedIndex="0">
                                                <ComboBoxItem Content="Single note" />
                                                <ComboBoxItem Content="Five-note melody" />
                                                <ComboBoxItem Content="Three-note chord" />
                                                <ComboBoxItem Content="Tempo (500 ms beat)" />
                                                <ComboBoxItem Content="Pause / resume" />
                                                <ComboBoxItem Content="Emergency stop" />
                                            </ComboBox>
                                            <Button Content="Arm test" Click="StartPlaybackTest" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" />
                                            <Button Content="Stop" Click="Stop" Margin="8,0,0,0" />
                                        </WrapPanel>
                                        <TextBlock x:Name="TestStatus" Text="No test running. Windows dispatch does not prove game receipt or an audible note." Foreground="{StaticResource AccentLavenderBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Integration diagnostics" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="DiagnosticsText" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="Counts cover scheduled key dispatches only; overlapping notes can share a hold. Lateness is measured at dispatch (late &gt; 10 ms); p95 uses 1 ms buckets capped at 2000 ms. Overlapping notes may share a key hold." Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                                    <StackPanel>
                                        <TextBlock Text="About larpiano" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <!-- Preserved verbatim taglines in About section -->
                                        <TextBlock Text="from da people who LARP, for da people who LARP" Foreground="#C3BCCB" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="for da people who larp  ·  for da poeple who believe in larpocracy" Foreground="#AAA3B6" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="Mapping profiles are saved as JSON. Only the selected foreground Roblox window receives key presses." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="Version 1.0.29  ·  Windows x64" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 6: UPDATER -->
                    <TabItem Header="Updates" Tag="⟳">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,100">
                            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                                <TextBlock Text="Updates" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Check for a new larpiano release." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,18" />
                                <Border Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                    <StackPanel>
                                        <TextBlock x:Name="InstalledUpdate" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="LatestUpdate" Text="Latest release: not checked" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,7,0,0" />
                                        <TextBlock x:Name="UpdaterMessage" Text="Check GitHub for a published release." Foreground="{StaticResource AccentLavenderBrush}" Margin="0,16,0,0" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,18,0,0">
                                            <Button x:Name="CheckUpdateButton" Content="Check for updates" Click="CheckForUpdates" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                            <Button x:Name="InstallUpdateButton" Content="Download and install" Click="InstallUpdate" IsEnabled="False" Margin="0,0,8,8" />
                                            <Button x:Name="CancelUpdateButton" Content="Cancel" Click="CancelUpdate" Visibility="Collapsed" Margin="0,0,8,8" />
                                            <Button Content="Open releases" Click="OpenReleases" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,8,0,0" />
                                        <TextBlock Text="The app restarts to finish installing. Your library and settings stay in place." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 7: REMAPPED MUSIC -->
                    <TabItem x:Name="RemappedTab" Header="Remapped music" Tag="♪">
                        <Grid Margin="32,24,32,100">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Remapped music" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Arrangements prepared for the Visual Pianos keyboard. Verify your own piano mapping before playing." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,16" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Search songs" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RemappedQuery" TextChanged="RemappedFilterChanged" ToolTip="Search title or artist" MinHeight="38" />
                                    <Button Grid.Column="1" Content="Refresh" Click="RefreshRemapped" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" />
                                    <Button Grid.Column="2" Content="Cancel" Click="CancelRemapped" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="RemappedList" Background="{StaticResource PanelElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" SelectionChanged="RemappedSelected" AutomationProperties.Name="Remapped songs">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="SongRow" Background="Transparent" Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderSubtleBrush}">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="SongRow" Property="Background" Value="#241E33" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="SongRow" Property="Background" Value="#3B2D57" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <Border Grid.Column="2" Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Arrangement details" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="RemappedDetails" Text="Select a song to see its source and mapping details." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        <WrapPanel Margin="0,16,0,0">
                                            <Button x:Name="RemappedDownload" Content="Download and select" Click="DownloadRemapped" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" IsEnabled="False" />
                                            <Button Content="Load piano layout" Click="LoadRemappedProfile" Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="RemappedStatus" Grid.Row="3" Text="Open this tab to load the catalogue." Foreground="{StaticResource AccentLavenderBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </Grid>
                </TabItem>

                <!-- TAB 8: MODERN PICKS -->
                <TabItem x:Name="ModernTab" Header="Modern picks" Tag="♫">
                    <Grid Margin="32,24,32,100">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Modern picks" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Connect your friends collection, then choose an arrangement to play." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <Border Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Friends collection" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentPurpleBrush}" />
                                    <TextBlock Text="Connect to see private songs alongside creator downloads." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,9" TextWrapping="Wrap" />
                                    <WrapPanel>
                                        <PasswordBox x:Name="FriendsCode" Width="230" MinHeight="38" Background="#171523" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" Padding="9,5" ToolTip="Friends collection access code" AutomationProperties.Name="Friends collection access code" />
                                        <Button x:Name="FriendsConnect" Content="Connect" Click="ConnectFriends" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" />
                                        <TextBlock x:Name="FriendsStatus" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <DockPanel LastChildFill="True">
                                <CheckBox x:Name="ModernFriendsOnly" DockPanel.Dock="Right" Content="Friends + creator downloads" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="12,0,0,0" Checked="ModernFriendsFilterChanged" Unchecked="ModernFriendsFilterChanged" />
                                <StackPanel>
                                    <TextBlock Text="Search songs or artists" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                    <TextBox x:Name="ModernQuery" MinHeight="38" ToolTip="Search by song or artist" TextChanged="ModernFilterChanged" AutomationProperties.Name="Search modern picks" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="ModernList" SelectionChanged="ModernSelected" MouseDoubleClick="ModernDoubleClick" Background="{StaticResource PanelElevatedBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" AutomationProperties.Name="Modern songs; friends arrangements appear first">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Row" Background="Transparent" Padding="12,9" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="#241E33" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="#3B2D57" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <Border Grid.Column="2" Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Selected song" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="ModernDetails" Text="Select a song to see your options." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,16,0,0">
                                            <Button x:Name="ModernDownloadButton" Content="Download and select" Click="DownloadModern" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" IsEnabled="False" />
                                            <Button x:Name="ModernSearchButton" Content="Search MIDI sources" Click="SearchModern" Margin="0,0,8,8" IsEnabled="False" />
                                            <Button x:Name="ModernLibraryButton" Content="Find in my library" Click="FindModernInLibrary" Margin="0,0,8,8" IsEnabled="False" />
                                        </WrapPanel>
                                        <TextBlock Text="Check the source's usage terms and verify your piano mapping before playback." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

            </TabControl>

            <!-- PERSISTENT BOTTOM PLAYER BAR (Anchored in Column 1 at the bottom with 14px bottom-right corner) -->
            <Border Grid.Column="1" VerticalAlignment="Bottom" Height="86" Background="#101018" BorderBrush="#1F1D2C" BorderThickness="0,1,0,0" Padding="38,0" CornerRadius="0,0,14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Artwork & Song Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Artwork Tile with Purple Ambient Glow -->
                        <Border Width="46" Height="46" CornerRadius="8" Background="#241E34" BorderBrush="#352D4B" BorderThickness="1">
                            <Grid ClipToBounds="True">
                                <Path Data="M 6,36 C 14,18 24,14 30,26 C 36,38 42,20 46,30" Stroke="{StaticResource AccentLavenderBrush}" StrokeThickness="2" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="♫" FontSize="16" Foreground="{StaticResource AccentLavenderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="190">
                            <TextBlock Text="—" x:Name="PlayerBarSongTitle" Style="{StaticResource PlayerSongTitleStyle}" />
                            <TextBlock Text="No song selected" x:Name="PlayerBarSongSubtitle" Style="{StaticResource PlayerSongSubtitleStyle}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Transport Controls & Seek Timeline -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
                        <!-- Transport Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <!-- Big Glowing Play/Pause Button -->
                            <Button x:Name="PlaybackButton" Style="{StaticResource GlowingPlayButtonStyle}" Click="PlayPause" ToolTip="Play / Pause">
                                <TextBlock Text="▶" FontSize="15" Margin="2,0,0,0" />
                            </Button>
                        </StackPanel>

                        <!-- Timeline Row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Elapsed" Text="0:00" Style="{StaticResource TimeDisplayTextStyle}" HorizontalAlignment="Left" />
                            <Slider x:Name="Progress" Grid.Column="1" Margin="8,0" Minimum="0" Maximum="100" IsEnabled="False"
                                    IsMoveToPointEnabled="True" SmallChange="1" LargeChange="5"
                                    Style="{StaticResource LarpianoTimelineSlider}" ValueChanged="TimelineChanged"
                                    ToolTip="Seek through the song." AutomationProperties.Name="Song timeline" />
                            <TextBlock x:Name="Duration" Grid.Column="2" Text="0:00" Style="{StaticResource TimeDisplayTextStyle}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- Right: Speed/Volume & Overlay -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Slider x:Name="Speed" Minimum="0.5" Maximum="2" Value="1" Width="82" ValueChanged="SpeedChanged"
                                Style="{StaticResource LarpianoMiniSlider}" ToolTip="Playback speed" />
                        <TextBlock x:Name="SpeedText" Text="100%" Style="{StaticResource TimeDisplayTextStyle}" Width="40" TextAlignment="Right" Margin="8,0,14,0" />
                        <!-- Sleek overlay toggle button -->
                        <Button Content="⧉" Click="ToggleOverlayClick" ToolTip="Toggle floating game overlay"
                                Style="{StaticResource TransportIconButton}" Foreground="{StaticResource AccentLavenderBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Border>
</Window>
