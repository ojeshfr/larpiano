<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Primitives -->
    <Color x:Key="OverlayCanvasColor">#0E0C16</Color>
    <Color x:Key="OverlaySurfaceColor">#141120</Color>
    <Color x:Key="OverlaySurfaceGlassColor">#F8141120</Color>
    <Color x:Key="OverlaySurfaceElevatedColor">#1C172C</Color>
    <Color x:Key="OverlaySurfaceElevatedGlassColor">#F41C172C</Color>
    <Color x:Key="OverlaySurfaceHoverColor">#2A223E</Color>
    <Color x:Key="OverlaySurfacePressedColor">#382C52</Color>

    <!-- Accents -->
    <Color x:Key="OverlayAccentColor">#A879FF</Color>
    <Color x:Key="OverlayAccentSoftColor">#C7A7FF</Color>
    <Color x:Key="OverlayAccentDeepColor">#7045B8</Color>
    <Color x:Key="OverlayAccentGlowColor">#55A879FF</Color>

    <!-- Typography -->
    <Color x:Key="OverlayTextPrimaryColor">#F7F3FF</Color>
    <Color x:Key="OverlayTextSecondaryColor">#B3AABD</Color>
    <Color x:Key="OverlayTextMutedColor">#81788D</Color>

    <!-- Borders -->
    <Color x:Key="OverlayBorderSubtleColor">#2E2542</Color>
    <Color x:Key="OverlayBorderMediumColor">#483A63</Color>
    <Color x:Key="OverlayBorderGlowingColor">#7A54BD</Color>

    <!-- Status Indicators -->
    <Color x:Key="OverlaySuccessColor">#45D69A</Color>
    <Color x:Key="OverlayWarningColor">#F2B96F</Color>
    <Color x:Key="OverlayDangerColor">#FF6B83</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="OverlayCanvasBrush" Color="{StaticResource OverlayCanvasColor}" />
    <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="{StaticResource OverlaySurfaceColor}" />
    <SolidColorBrush x:Key="OverlaySurfaceGlassBrush" Color="{StaticResource OverlaySurfaceGlassColor}" />
    <SolidColorBrush x:Key="OverlaySurfaceElevatedBrush" Color="{StaticResource OverlaySurfaceElevatedColor}" />
    <SolidColorBrush x:Key="OverlaySurfaceElevatedGlassBrush" Color="{StaticResource OverlaySurfaceElevatedGlassColor}" />
    <SolidColorBrush x:Key="OverlaySurfaceHoverBrush" Color="{StaticResource OverlaySurfaceHoverColor}" />
    <SolidColorBrush x:Key="OverlaySurfacePressedBrush" Color="{StaticResource OverlaySurfacePressedColor}" />

    <SolidColorBrush x:Key="OverlayAccentBrush" Color="{StaticResource OverlayAccentColor}" />
    <SolidColorBrush x:Key="OverlayAccentSoftBrush" Color="{StaticResource OverlayAccentSoftColor}" />
    <SolidColorBrush x:Key="OverlayAccentDeepBrush" Color="{StaticResource OverlayAccentDeepColor}" />
    <SolidColorBrush x:Key="OverlayAccentGlowBrush" Color="{StaticResource OverlayAccentGlowColor}" />

    <SolidColorBrush x:Key="OverlayTextPrimaryBrush" Color="{StaticResource OverlayTextPrimaryColor}" />
    <SolidColorBrush x:Key="OverlayTextSecondaryBrush" Color="{StaticResource OverlayTextSecondaryColor}" />
    <SolidColorBrush x:Key="OverlayTextMutedBrush" Color="{StaticResource OverlayTextMutedColor}" />

    <SolidColorBrush x:Key="OverlayBorderSubtleBrush" Color="{StaticResource OverlayBorderSubtleColor}" />
    <SolidColorBrush x:Key="OverlayBorderMediumBrush" Color="{StaticResource OverlayBorderMediumColor}" />
    <SolidColorBrush x:Key="OverlayBorderGlowingBrush" Color="{StaticResource OverlayBorderGlowingColor}" />

    <SolidColorBrush x:Key="OverlaySuccessBrush" Color="{StaticResource OverlaySuccessColor}" />
    <SolidColorBrush x:Key="OverlayWarningBrush" Color="{StaticResource OverlayWarningColor}" />
    <SolidColorBrush x:Key="OverlayDangerBrush" Color="{StaticResource OverlayDangerColor}" />

    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="OverlayGlassBorderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8561C8" Offset="0.0" />
        <GradientStop Color="#3D3055" Offset="0.5" />
        <GradientStop Color="#5A408E" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OverlayPlayButtonGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#352656" Offset="0" />
        <GradientStop Color="#23173E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OverlayProgressGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8453D8" Offset="0" />
        <GradientStop Color="#A879FF" Offset="0.8" />
        <GradientStop Color="#C7A7FF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
