<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="OverlayColors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="OverlayAppFontFamily">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="OverlayMonoFontFamily">Consolas, Segoe UI Mono, monospace</FontFamily>

    <!-- Header Styles -->
    <Style x:Key="OverlayHeaderBrandTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OverlayAppFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource OverlayTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="OverlayHeaderBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OverlayAppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource OverlayAccentSoftBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Song Detail Styles -->
    <Style x:Key="OverlaySongTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OverlayAppFontFamily}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource OverlayTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="OverlaySongMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OverlayAppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource OverlayTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Compact Text Style -->
    <Style x:Key="OverlayCompactSongTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OverlayAppFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource OverlayTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Time Styles -->
    <Style x:Key="OverlayTimeDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OverlayMonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource OverlayTextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Shortcut Card Text Styles -->
    <Style x:Key="OverlayShortcutTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OverlayAppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource OverlayTextPrimaryBrush}" />
    </Style>

    <Style x:Key="OverlayShortcutSublabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OverlayAppFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource OverlayTextMutedBrush}" />
    </Style>

    <!-- Timeline Lane Style -->
    <Style x:Key="OverlayTimelineLaneLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OverlayMonoFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource OverlayTextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="OverlayTimelineTickLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OverlayMonoFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource OverlayTextMutedBrush}" />
    </Style>

</ResourceDictionary>
