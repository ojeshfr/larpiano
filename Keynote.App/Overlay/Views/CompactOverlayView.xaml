<UserControl x:Class="Keynote.App.Overlay.Views.CompactOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overlay="clr-namespace:Keynote.App.Overlay"
             xmlns:converters="clr-namespace:Keynote.App.Overlay.Converters"
             Focusable="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Keynote.App;component/Overlay/Themes/OverlayColors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Keynote.App;component/Overlay/Themes/OverlayTypography.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Keynote.App;component/Overlay/Themes/OverlayControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:PinTextConverter x:Key="PinTextConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent" MouseDown="OnBarMouseDown">
        <Border Padding="14,10,14,10">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Logo & Brand -->
                    <ColumnDefinition Width="Auto" /> <!-- Song & Time Info -->
                    <ColumnDefinition Width="*" />    <!-- Progress Bar -->
                    <ColumnDefinition Width="Auto" /> <!-- Transport & Actions -->
                </Grid.ColumnDefinitions>

                <!-- 1. Branding: Piano Logo Mark & Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Width="24" Height="24" CornerRadius="6" Background="#261C3D" BorderBrush="{StaticResource OverlayAccentDeepBrush}" BorderThickness="1" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="3.5" Height="12" Background="{StaticResource OverlayTextPrimaryBrush}" CornerRadius="1" Margin="1,0" />
                            <Border Width="3.5" Height="12" Background="{StaticResource OverlayTextPrimaryBrush}" CornerRadius="1" Margin="1,0" />
                            <Border Width="3.5" Height="12" Background="{StaticResource OverlayTextPrimaryBrush}" CornerRadius="1" Margin="1,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="larpiano" Style="{StaticResource OverlayHeaderBrandTextStyle}" Margin="0,0,6,0" />
                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="{Binding TargetWindowTitle}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource OverlayWarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTargetForeground}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource OverlaySuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </StackPanel>

                <!-- 2. Song Title & Time -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding SongTitle}" Style="{StaticResource OverlayCompactSongTitleStyle}" MaxWidth="160" TextTrimming="CharacterEllipsis" ToolTip="{Binding SongTitle}" />
                    <TextBlock Text="{Binding TimeString}" Style="{StaticResource OverlayTimeDisplayTextStyle}" FontSize="11" Margin="0,1,0,0" ToolTip="{Binding TimeString}" />
                </StackPanel>

                <!-- 3. Short Progress Slider -->
                <Slider Grid.Column="2"
                        Style="{StaticResource OverlayPlaybackSliderStyle}"
                        Minimum="0" Maximum="1"
                        Value="{Binding Progress, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"
                        ToolTip="Seek Playback" />

                <!-- 4. Transport & Control Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Play / Pause Button (glowing) -->
                    <Button Style="{StaticResource OverlayGlowingPlayButtonStyle}"
                            Click="OnPlayPauseClick"
                            ToolTip="Play / Pause"
                            Width="36" Height="36"
                            Margin="0,0,6,0">
                        <Grid>
                            <Path Fill="#FFFFFF"
                                  Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                  Stretch="Uniform" Width="11" Height="11"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}" />
                            <Path Fill="#FFFFFF"
                                  Data="M14,19H18V5H14M6,19H10V5H6V19Z"
                                  Stretch="Uniform" Width="11" Height="11"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                        </Grid>
                    </Button>

                    <!-- Stop Button -->
                    <Button Style="{StaticResource OverlayButtonStyle}"
                            Click="OnStopClick"
                            ToolTip="Emergency Stop"
                            Width="34" Height="34"
                            Margin="0,0,6,0">
                        <Path Fill="{StaticResource OverlayDangerBrush}" Data="M18,18H6V6H18V18Z" Stretch="Uniform" Width="10" Height="10" />
                    </Button>

                    <!-- Speed Selector Button -->
                    <Button Style="{StaticResource OverlayButtonStyle}"
                            Click="OnSpeedClick"
                            ToolTip="Cycle Playback Speed"
                            Padding="8,4"
                            Margin="0,0,6,0">
                        <TextBlock Text="{Binding SpeedText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OverlayTextPrimaryBrush}" />
                    </Button>

                    <Button Content="MIDI" Click="OnBrowseMidiClick" ToolTip="Browse MIDI files" Style="{StaticResource OverlayButtonStyle}" Padding="6,4" Margin="0,0,4,0" />
                    <!-- Pin Toggle Button -->
                    <ToggleButton Style="{StaticResource OverlayHeaderToggleButtonStyle}"
                                  IsChecked="{Binding IsPinned}"
                                  ToolTip="Always on Top (Pin)"
                                  Width="30" Height="30"
                                  Margin="0,0,4,0">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Data="M12,2A1,1 0 0,1 13,3V7.58L15.29,9.88A1,1 0 0,1 15.58,10.59V12H9.41V10.59A1,1 0 0,1 9.71,9.88L12,7.58V3A1,1 0 0,1 12,2M11.5,13H13.5V20.5A0.5,0.5 0 0,1 13,21A0.5,0.5 0 0,1 12.5,20.5V13H11.5Z"
                              Stretch="Uniform" Width="12" Height="12" />
                    </ToggleButton>

                    <!-- Expand Mode Button -->
                    <Button Style="{StaticResource OverlayHeaderWindowButtonStyle}"
                            Click="OnExpandClick"
                            ToolTip="Expand Full Overlay"
                            Width="30" Height="30"
                            Margin="0,0,4,0">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                              Stretch="Uniform" Width="12" Height="12" />
                    </Button>

                    <!-- Close Button -->
                    <Button Style="{StaticResource OverlayHeaderCloseButtonStyle}"
                            Click="OnCloseClick"
                            ToolTip="Hide Overlay"
                            Width="30" Height="30">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Stretch="Uniform" Width="10" Height="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
